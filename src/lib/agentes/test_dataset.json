  "project_name": "Suíte de Testes dos 18 chats do ERP Line",
  "version": "1.0",
  "global_settings": {
    "repetitions_per_test": 3,
    "scoring_type": "binary_0_or_1",
    "enable_runtime_auto_fix": true
