  "test_cases": [
    {
      "test_id": "TC-ELO-E2E-01",
      "target_agent": "ELO",
      "agent_name": "Chat principal (organiza os chats)",
      "test_level": 1,
      "level_name": "End-to-End (Resposta Final)",
      "input": {
        "user_prompt": "Abra um chat novo para cuidar das assinaturas de software da MF."
      },
      "evaluation_config": {
        "evaluator_method": "LLM-as-Judge",
        "deterministic_checks": [
          "resposta_em_portugues",
          "termina_com_data_hora_brasilia",
          "sem_dados_sensiveis"
        ],
        "judge_criteria": [
          "Dá ao chat novo uma sigla de 3 letras que ainda não existe na lista?",
          "Explica em linguagem simples o que o chat novo vai fazer e o que fica com os outros chats?",
          "Respeita o limite de no máximo 20 chats e diz quantos ficam?"
        ],
        "expected_score": 1
      }
    },
    {
      "test_id": "TC-ELO-STEP-01",
      "target_agent": "ELO",
      "agent_name": "Chat principal (organiza os chats)",
      "test_level": 2,
      "level_name": "Single Step (Seleção de Ferramenta)",
      "input": {
        "previous_context": "A usuária escreveu no ELO: 'a nota da Matriz SC foi rejeitada, conserta'.",
